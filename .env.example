# Copy to .env and populate with unique secrets. Never commit .env.

# PostgreSQL / Prisma
POSTGRES_USER=uprm
POSTGRES_PASSWORD=
POSTGRES_DB=uprm
DATABASE_URL=

# Redis (provisioned by the local infrastructure stack)
REDIS_PASSWORD=
REDIS_URL=

# RabbitMQ (must agree with the broker user/password in its persisted volume)
RABBITMQ_USER=uprm
RABBITMQ_PASSWORD=
RABBITMQ_URL=

# MinIO (provisioned for object-storage expansion)
MINIO_USER=uprm
MINIO_PASSWORD=
MINIO_ENDPOINT=http://127.0.0.1:9000

# Observability
GRAFANA_PASSWORD=

# UPRM application secrets
UPRM_MASTER_SECRET=
UPRM_ADMIN_BOOTSTRAP_TOKEN=
UPRM_ADMIN_JWT_SECRET=
# Optional JWT claim checks / asymmetric verification alternative
UPRM_ADMIN_JWT_ISSUER=
UPRM_ADMIN_JWT_AUDIENCE=
UPRM_ADMIN_JWT_PUBLIC_KEY=

# Stripe API access. Stripe webhook secrets are configured per tenant.
STRIPE_SECRET_KEY=

# Feature flags
UPRM_WALLET_V2_READS=false

# Service-specific; set independently in each process/systemd unit.
# api-core defaults to 4000, admin-api to 4001, worker to 4002.
PORT=

# Optional admin browser end-to-end test settings
UPRM_ADMIN_E2E_BASE_URL=
UPRM_ADMIN_E2E_EMAIL=
UPRM_ADMIN_E2E_PASSWORD=
