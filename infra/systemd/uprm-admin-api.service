[Unit]
Description=UPRM admin-api (bootstrap admin API)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=uprm
Group=uprm
WorkingDirectory=/srv/uprm/apps/admin-api
EnvironmentFile=/srv/uprm/.env
Environment=PORT=4001
Environment=PATH=/home/uprm/.nvm/versions/node/v20.20.2/bin:/usr/bin:/bin
ExecStart=/home/uprm/.nvm/versions/node/v20.20.2/bin/pnpm run start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uprm-admin-api

[Install]
WantedBy=multi-user.target
