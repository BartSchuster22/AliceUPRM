[Unit]
Description=UPRM API Core (tenant-facing HMAC API)
Documentation=file:///srv/uprm/docs/deployment/INSTALL.md
Requires=uprm-infrastructure.service
After=uprm-infrastructure.service network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=uprm
Group=uprm
WorkingDirectory=/srv/uprm/apps/api-core
EnvironmentFile=/srv/uprm/.env
Environment=PORT=4000
Environment=NODE_ENV=production
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/home/uprm/.local/share/pnpm
ExecStartPre=/srv/uprm/scripts/validate-env.sh --production /srv/uprm/.env
ExecStartPre=/usr/bin/test -f /srv/uprm/apps/api-core/dist/main.js
ExecStart=/usr/bin/env pnpm run start:prod
Restart=on-failure
RestartSec=3
TimeoutStartSec=45
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uprm-api-core

[Install]
WantedBy=multi-user.target
