[Unit]
Description=UPRM worker (outbox relay + reward consumer + scheduler)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=uprm
Group=uprm
WorkingDirectory=/srv/uprm/apps/worker
EnvironmentFile=/srv/uprm/.env
Environment=PORT=4002
Environment=PATH=/home/uprm/.nvm/versions/node/v20.20.2/bin:/usr/bin:/bin
ExecStart=/home/uprm/.nvm/versions/node/v20.20.2/bin/pnpm run start
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=uprm-worker

[Install]
WantedBy=multi-user.target
