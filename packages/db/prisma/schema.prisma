generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// TENANT & API KEY MODELS
// ============================================================

model Tenant {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  status        String   @default("active")
  baseCurrency  String   @default("EUR")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  apiKeys       TenantApiKey[]
  config        TenantConfig?
  tenantUsers   TenantUser[]

  @@map("tenants")
}

model TenantApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  keyHash     String    @unique
  keyPrefix   String    @unique
  scopes      String[]  @default([])
  status      String    @default("active")
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@map("tenant_api_keys")
}

model TenantConfig {
  tenantId          String   @id
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rewardConfig      Json     @default("{}")
  promoterConfig    Json     @default("{}")
  fraudConfig       Json     @default("{}")
  webhookConfig     Json     @default("{}")
  updatedAt         DateTime @updatedAt

  @@map("tenant_configs")
}

// ============================================================
// IDENTITY MODELS
// ============================================================

model User {
  id              String       @id @default(uuid())
  emailNormalized String       @unique
  emailVerified   Boolean      @default(false)
  status          String       @default("active")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  tenantUsers     TenantUser[]

  @@map("users")
}

model TenantUser {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalUserId String
  username       String?
  tenantStatus   String   @default("active")
  joinedAt       DateTime @default(now())
  metadata       Json     @default("{}")

  @@unique([tenantId, externalUserId])
  @@index([userId])
  @@map("tenant_users")
}


// ============================================================
// REFERRAL GRAPH MODELS
// ============================================================

model ReferralCode {
  id            String    @id @default(uuid())
  tenantId      String
  tenantUserId  String
  code          String
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?

  @@unique([tenantId, code])
  @@index([tenantUserId])
  @@map("referral_codes")
}

model ReferralEdge {
  id                       String    @id @default(uuid())
  tenantId                 String
  referrerTenantUserId     String
  referredTenantUserId     String
  sourceCodeId             String?
  attributionMethod        String    @default("code")
  createdAt                DateTime  @default(now())
  lockedAt                 DateTime?

  @@unique([tenantId, referredTenantUserId])
  @@index([tenantId, referrerTenantUserId])
  @@map("referral_edges")
}

model ReferralAncestry {
  tenantId                 String
  ancestorTenantUserId     String
  descendantTenantUserId   String
  depth                    Int
  createdAt                DateTime  @default(now())

  @@id([tenantId, descendantTenantUserId, ancestorTenantUserId])
  @@index([tenantId, ancestorTenantUserId])
  @@map("referral_ancestry")
}


// ============================================================
// EVENT INGESTION MODELS
// ============================================================

model IngestedEvent {
  id                 String    @id @default(uuid())
  tenantId           String
  eventType          String
  externalEventId    String
  externalUserId     String?
  tenantUserId       String?
  payload            Json
  occurredAt         DateTime
  receivedAt         DateTime  @default(now())
  idempotencyKey     String
  processingStatus   String    @default("queued")
  processingAttempts Int       @default(0)
  errorCode          String?
  errorMessage       String?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, eventType, occurredAt])
  @@index([processingStatus, receivedAt])
  @@map("ingested_events")
}

model OutboxMessage {
  id           String    @id @default(uuid())
  aggregateId  String
  topic        String
  payload      Json
  status       String    @default("pending")
  attempts     Int       @default(0)
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?
  lastError    String?

  @@index([status, createdAt])
  @@map("outbox_messages")
}

model EventLink {
  id            String   @id @default(uuid())
  tenantId      String
  eventId       String
  linkedEventId String
  linkType      String
  createdAt     DateTime @default(now())

  @@index([tenantId, eventId])
  @@index([tenantId, linkedEventId])
  @@map("event_links")
}


// ============================================================
// LEDGER MODELS  (Phase 4)
// ============================================================

model LedgerAccount {
  id            String   @id @default(uuid())
  tenantId      String
  accountType   String   // 'tenant_cash' | 'tenant_revenue' | 'tenant_reward_expense' | 'user_balance' | 'platform_fee'
  tenantUserId  String?  // null for system accounts; set for user_balance
  currency      String
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  postings      LedgerPosting[]

  // One account per (tenant, type, user, currency). Nulls are distinct in Postgres,
  // so user_balance uniqueness is effectively (tenantId, accountType, tenantUserId, currency).
  @@unique([tenantId, accountType, tenantUserId, currency])
  @@index([tenantId, currency])
  @@map("ledger_accounts")
}

model LedgerEntry {
  id              String   @id @default(uuid())
  tenantId        String
  currency        String
  description     String
  idempotencyKey  String
  sourceEventId   String?  // link back to the ingested_events row that caused this entry
  createdAt       DateTime @default(now())

  postings        LedgerPosting[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([sourceEventId])
  @@map("ledger_entries")
}

model LedgerPosting {
  id         String   @id @default(uuid())
  entryId    String
  entry      LedgerEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId  String
  account    LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount     BigInt   // positive = debit, negative = credit; entry sum must equal 0
  currency   String   // must match entry.currency and account.currency
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([entryId])
  @@map("ledger_postings")
}

model ScheduledPosting {
  id                    String    @id @default(uuid())
  tenantId              String
  beneficiaryTenantUserId String?
  sourceEventId         String    // event that triggered the scheduling
  postAt                DateTime  // when the settlement window expires and this becomes eligible
  status                String    @default("pending") // 'pending' | 'posted' | 'cancelled'
  idempotencyKey        String
  payload               Json      // {postings: [{accountId, amount, currency}, ...], description, currency}
  resultEntryId         String?   // set after successful post
  cancelReason          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([tenantId, idempotencyKey])
  @@index([status, postAt])
  @@index([sourceEventId])
  @@index([tenantId, beneficiaryTenantUserId, status])
  @@map("scheduled_postings")
}

model PayoutRequest {
  id                  String   @id @default(uuid())
  tenantId            String
  tenantUserId        String
  amountMinor         BigInt
  baseCurrency        String
  destinationCurrency String?
  payoutMethod        String
  destination         Json
  status              String   @default("requested") // requested | approved | sent | failed | cancelled
  failureReason       String?
  externalPayoutId    String?
  approvedAt          DateTime?
  sentAt              DateTime?
  failedAt            DateTime?
  cancelledAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, tenantUserId, createdAt])
  @@index([status, createdAt])
  @@map("payout_requests")
}

model PromoterProfile {
  id                  String    @id @default(uuid())
  tenantId            String
  tenantUserId        String
  promoterStatus      String    @default("user") // user | promoter | pending_review | suspended | demoted
  qualificationSource String    @default("manual") // auto | manual | none
  manualOverride      Boolean   @default(false)
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  updatedAt           DateTime  @updatedAt

  @@index([tenantId, tenantUserId, effectiveFrom])
  @@index([tenantId, tenantUserId, effectiveTo])
  @@map("promoter_profiles")
}

model PromoterApplication {
  id                String   @id @default(uuid())
  tenantId          String
  tenantUserId      String
  submittedAt       DateTime @default(now())
  status            String   @default("submitted") // submitted | under_review | approved | rejected
  reviewedByAdminId String?
  reviewedAt        DateTime?
  notes             String?
  updatedAt         DateTime @updatedAt

  links             PromoterApplicationLink[]

  @@index([tenantId, tenantUserId, submittedAt])
  @@index([tenantId, status, submittedAt])
  @@map("promoter_applications")
}

model PromoterApplicationLink {
  id                 String   @id @default(uuid())
  applicationId      String
  application        PromoterApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  linkType           String
  url                String
  verificationStatus String   @default("unverified") // unverified | verified | rejected
  proofJson          Json?

  @@index([applicationId])
  @@map("promoter_application_links")
}

model PromoterMetricsDaily {
  id                    String   @id @default(uuid())
  tenantId              String
  tenantUserId          String
  date                  DateTime
  newPaidReferralsCount Int      @default(0)
  grossRevenueReferred  BigInt   @default(0)
  netRewardGenerated    BigInt   @default(0)
  refundCount           Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, tenantUserId, date])
  @@index([tenantId, date])
  @@index([tenantUserId, date])
  @@map("promoter_metrics_daily")
}

model SettlementCycle {
  id                    String   @id @default(uuid())
  tenantId              String
  currency              String
  periodStart           DateTime
  periodEnd             DateTime
  status                String   @default("open") // open | closed
  ledgerLiabilityMinor  BigInt   @default(0)
  pendingLiabilityMinor BigInt   @default(0)
  totalLiabilityMinor   BigInt   @default(0)
  note                  String?
  openedByAdminId       String?
  openedAt              DateTime @default(now())
  closedByAdminId       String?
  closedAt              DateTime?
  updatedAt             DateTime @updatedAt

  @@index([tenantId, status, openedAt])
  @@index([tenantId, periodStart, periodEnd])
  @@map("settlement_cycles")
}

model AdminUser {
  id           String   @id @default(uuid())
  subject      String   @unique
  email        String?  @unique
  displayName  String?
  passwordHash String?
  roles        String[] @default([])
  status       String   @default("active")
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs    AuditLog[]

  @@map("admin_users")
}

model AuditLog {
  id               String     @id @default(uuid())
  actorAdminUserId String?
  actorSubject     String
  actorEmail       String?
  actorRoles       String[]   @default([])
  tenantId         String?
  route            String
  method           String
  action           String
  resourceType     String
  resourceId       String?
  beforeJson       Json?
  afterJson        Json?
  createdAt        DateTime   @default(now())
  adminUser        AdminUser? @relation(fields: [actorAdminUserId], references: [id], onDelete: SetNull)

  @@index([actorAdminUserId, createdAt])
  @@index([tenantId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model WebhookDelivery {
  id             String   @id @default(uuid())
  tenantId       String
  eventType      String
  endpointUrl    String
  signingSecret  String
  payload        Json
  status         String   @default("pending")
  attemptCount   Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  lastAttemptAt  DateTime?
  deliveredAt    DateTime?
  lastStatusCode Int?
  lastError      String?
  sourceTopic    String?
  sourceEventId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([tenantId, eventType, createdAt])
  @@map("webhook_deliveries")
}

model RiskSignal {
  id            String   @id @default(uuid())
  tenantId      String
  tenantUserId  String?
  signalType    String
  score         Int
  severity      String
  status        String   @default("active")
  dedupeKey     String?
  sourceEventId String?
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  openedCases   RiskCase[]

  @@index([tenantId, createdAt])
  @@index([tenantUserId, createdAt])
  @@index([signalType, createdAt])
  @@unique([tenantId, dedupeKey])
  @@map("risk_signals")
}

model RiskCase {
  id                  String   @id @default(uuid())
  tenantId            String
  tenantUserId        String?
  status              String   @default("open")
  severity            String
  scoreTotal          Int
  thresholdSnapshot   Json     @default("{}")
  resolution          String?
  resolutionNote      String?
  openedBySignalId    String?
  openedBySignal      RiskSignal? @relation(fields: [openedBySignalId], references: [id], onDelete: SetNull)
  openedAt            DateTime @default(now())
  resolvedAt          DateTime?

  events              RiskCaseEvent[]
  rewardHolds         RewardHold[]

  @@index([tenantId, status, openedAt])
  @@index([tenantUserId, status])
  @@map("risk_cases")
}

model RiskCaseEvent {
  id          String   @id @default(uuid())
  riskCaseId  String
  riskCase    RiskCase @relation(fields: [riskCaseId], references: [id], onDelete: Cascade)
  actorType   String
  actorId     String?
  action      String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime @default(now())

  @@index([riskCaseId, createdAt])
  @@map("risk_case_events")
}

model RewardHold {
  id                String   @id @default(uuid())
  tenantId          String
  tenantUserId      String
  scheduledPostingId String
  riskCaseId        String
  riskCase          RiskCase @relation(fields: [riskCaseId], references: [id], onDelete: Cascade)
  status            String   @default("active")
  reasonCode        String
  createdAt         DateTime @default(now())
  releasedAt        DateTime?
  rejectedAt        DateTime?

  @@unique([scheduledPostingId])
  @@index([tenantId, status, createdAt])
  @@index([tenantUserId, status])
  @@map("reward_holds")
}

model ConversionDaily {
  id                    String   @id @default(uuid())
  tenantId              String
  day                   DateTime
  eventType             String
  eventCount            Int
  distinctExternalUsers Int
  distinctTenantUsers   Int
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([tenantId, day, eventType])
  @@index([tenantId, day])
  @@map("conversion_daily")
}

model RewardPerformanceDaily {
  id                       String   @id @default(uuid())
  tenantId                 String
  day                      DateTime
  currency                 String
  rewardEntryCount         Int
  rewardExpenseMinor       BigInt
  distinctBeneficiaryUsers Int
  postedScheduledCount     Int
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([tenantId, day, currency])
  @@index([tenantId, day])
  @@map("reward_performance_daily")
}

model TenantLiabilityDaily {
  id                   String   @id @default(uuid())
  tenantId             String
  day                  DateTime
  currency             String
  rawLiabilityMinor    BigInt
  displayLiabilityMinor BigInt
  accountCount         Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, day, currency])
  @@index([tenantId, day])
  @@map("tenant_liability_daily")
}

model CohortRetentionDaily {
  id            String   @id @default(uuid())
  tenantId      String
  cohortDay     DateTime
  activityDay   DateTime
  cohortSize    Int
  retainedUsers Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, cohortDay, activityDay])
  @@index([tenantId, cohortDay])
  @@index([tenantId, activityDay])
  @@map("cohort_retention_daily")
}
